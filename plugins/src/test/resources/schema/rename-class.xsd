<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="https://www.github.com/rawvoid/xjc-plugins/rename"
           xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
           targetNamespace="https://www.github.com/rawvoid/xjc-plugins/rename"
           jaxb:version="3.0"
           elementFormDefault="qualified">

    <!-- Unconflicted bean renames. -->
    <xs:complexType name="Person">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="AddressType">
        <xs:sequence>
            <xs:element name="city" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Global enum for unconflicted rename. -->
    <xs:simpleType name="Color">
        <xs:restriction base="xs:string">
            <xs:enumeration value="RED"/>
            <xs:enumeration value="BLUE"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Two beans that can be mapped onto the same target name (conflict fixture). -->
    <xs:complexType name="Alpha">
        <xs:sequence>
            <xs:element name="value" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Beta">
        <xs:sequence>
            <xs:element name="value" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Nested types under a holder (package filter still uses owner package). -->
    <xs:complexType name="Holder">
        <xs:sequence>
            <xs:element name="item">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="note" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="status">
                <xs:simpleType>
                    <xs:annotation>
                        <xs:appinfo>
                            <jaxb:typesafeEnumClass name="LocalStatus"/>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:restriction base="xs:string">
                        <xs:enumeration value="OPEN"/>
                        <xs:enumeration value="CLOSED"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!--
      Parent-child same simple name after Type-suffix strip:
      NamedAssocType → NamedAssoc would clash with nested NamedAssoc.
    -->
    <xs:complexType name="NamedAssocType">
        <xs:sequence>
            <xs:element name="NamedAssoc">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="value" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!--
      ObjectFactory squeezed-name fixture (use with -Xpromote-nested-class):
      - package Address blocks nested Address promotion under EmailType
      - HolderType.EmailAddress promotes to package EmailAddress
      - EmailType → Email would make nested Address squeezed name "EmailAddress"
    -->
    <xs:complexType name="BlockAddress">
        <xs:sequence>
            <xs:element name="Address">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="line" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="HolderType">
        <xs:sequence>
            <xs:element name="EmailAddress">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="value" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="EmailType">
        <xs:sequence>
            <xs:element name="Address">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="value" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="person" type="tns:Person"/>
    <xs:element name="address" type="tns:AddressType"/>
    <xs:element name="holder" type="tns:Holder"/>
    <xs:element name="namedAssoc" type="tns:NamedAssocType"/>
    <xs:element name="blockAddress" type="tns:BlockAddress"/>
    <xs:element name="holderType" type="tns:HolderType"/>
    <xs:element name="email" type="tns:EmailType"/>
</xs:schema>
