<!--
  Fixtures for FlattenMultiElementPropPlugin:
  - Unbounded multi-element choice → flattened to individual fields
  - Two multi choices on one type → both flattened
  - Plain single-element list must keep its natural name
  - Base + extension element name collision → multi-member rest → flattened
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="https://www.github.com/rawvoid/xjc-plugins/flatten-multi-element-prop"
           targetNamespace="https://www.github.com/rawvoid/xjc-plugins/flatten-multi-element-prop"
           elementFormDefault="qualified">

    <!-- One unbounded choice → single merged property without the plugin. -->
    <xs:complexType name="Flight">
        <xs:choice maxOccurs="unbounded">
            <xs:element name="AirportCode" type="xs:string"/>
            <xs:element name="Date" type="xs:string"/>
            <xs:element name="Time" type="xs:string"/>
        </xs:choice>
    </xs:complexType>

    <!-- Two multi-element choices on one type → both flattened. -->
    <xs:complexType name="DualChoice">
        <xs:sequence>
            <xs:choice maxOccurs="unbounded">
                <xs:element name="One" type="xs:string"/>
                <xs:element name="Two" type="xs:string"/>
            </xs:choice>
            <xs:choice maxOccurs="unbounded">
                <xs:element name="Red" type="xs:string"/>
                <xs:element name="Green" type="xs:string"/>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>

    <!-- Plain single-element list must keep its natural name. -->
    <xs:complexType name="PlainList">
        <xs:sequence>
            <xs:element name="Tag" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="GlobalItemClass" nillable="true">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="value" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="ChoiceWithClass">
        <xs:choice maxOccurs="unbounded">
            <xs:element ref="tns:GlobalItemClass"/>
            <xs:element name="PlainString" type="xs:string"/>
        </xs:choice>
    </xs:complexType>

    <xs:complexType name="ConflictBase">
        <xs:sequence>
            <xs:element name="Time" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ConflictDerived">
        <xs:complexContent>
            <xs:extension base="tns:ConflictBase">
                <xs:choice maxOccurs="unbounded">
                    <xs:element name="Time" type="xs:string"/>
                    <xs:element name="Note" type="xs:string"/>
                </xs:choice>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!--
      Global element classes (CClassInfo implements CElement). mixed="true" forces
      CReferencePropertyInfo so convertToElementProperty hits the CClassInfo branch
      (must pass ID.NONE, not null — BeanGenerator NPEs on prop.id() == null).
    -->
    <xs:element name="AlphaBlock">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="code" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="BetaBlock">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="code" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="MixedClassRefs" mixed="true">
        <xs:choice maxOccurs="unbounded">
            <xs:element ref="tns:AlphaBlock"/>
            <xs:element ref="tns:BetaBlock"/>
        </xs:choice>
    </xs:complexType>

    <xs:complexType name="DocChoice">
        <xs:annotation>
            <xs:documentation>Choice container documentation.</xs:documentation>
        </xs:annotation>
        <xs:choice maxOccurs="unbounded">
            <xs:element name="DocFieldA" type="xs:string">
                <xs:annotation>
                    <xs:documentation>DocFieldA documentation.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="DocFieldB" type="xs:string">
                <xs:annotation>
                    <xs:documentation>DocFieldB documentation.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:choice>
    </xs:complexType>

    <xs:element name="flight" type="tns:Flight"/>
    <xs:element name="dual" type="tns:DualChoice"/>
    <xs:element name="plain" type="tns:PlainList"/>
    <xs:element name="choiceWithClass" type="tns:ChoiceWithClass"/>
    <xs:element name="conflictDerived" type="tns:ConflictDerived"/>
    <xs:element name="mixedClassRefs" type="tns:MixedClassRefs"/>
    <xs:element name="docChoice" type="tns:DocChoice"/>
</xs:schema>

