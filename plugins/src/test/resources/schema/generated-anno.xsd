<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="https://www.github.com/rawvoid/xjc-plugins/generated-anno"
           targetNamespace="https://www.github.com/rawvoid/xjc-plugins/generated-anno"
           elementFormDefault="qualified">

    <xs:complexType name="Root">
        <xs:sequence>
            <xs:element name="value" type="xs:string"/>
            <xs:element name="nested" type="tns:Nested"/>
            <xs:element name="status" type="tns:Status"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Nested">
        <xs:sequence>
            <xs:element name="nestedValue" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="Status">
        <xs:restriction base="xs:string">
            <xs:enumeration value="ACTIVE"/>
            <xs:enumeration value="INACTIVE"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="root" type="tns:Root"/>
</xs:schema>
