<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="https://www.github.com/rawvoid/xjc-plugins/lombok"
           targetNamespace="https://www.github.com/rawvoid/xjc-plugins/lombok"
           elementFormDefault="qualified">

    <!-- Plain bean for default @Data / builder / regex cases. -->
    <xs:complexType name="Person">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="age" type="xs:int"/>
            <xs:element name="active" type="xs:boolean"/>
            <!-- Plural list name → @Singular without value (Lombok auto-singularize). -->
            <xs:element name="nicknames" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
            <!-- Singular-looking list name → @Singular(value = "tag"). -->
            <xs:element name="tag" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Sibling type so regex can target Person only. -->
    <xs:complexType name="Order">
        <xs:sequence>
            <xs:element name="id" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Inheritance fixture for @EqualsAndHashCode(callSuper = true). -->
    <xs:complexType name="BaseType" abstract="true"/>

    <xs:complexType name="EmptyChild">
        <xs:complexContent>
            <xs:extension base="tns:BaseType"/>
        </xs:complexContent>
    </xs:complexType>

    <xs:element name="person" type="tns:Person"/>
    <xs:element name="order" type="tns:Order"/>
    <xs:element name="emptyChild" type="tns:EmptyChild"/>
</xs:schema>
