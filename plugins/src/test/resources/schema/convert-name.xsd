<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="https://www.github.com/rawvoid/xjc-plugins/convert-name"
           targetNamespace="https://www.github.com/rawvoid/xjc-plugins/convert-name"
           elementFormDefault="qualified">

    <xs:complexType name="Person">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="age" type="xs:int"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Second class for multi-rule class-name conversion. -->
    <xs:complexType name="RootType">
        <xs:sequence>
            <xs:element name="label" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Enum values exercise constant-name conversion. -->
    <xs:simpleType name="Color">
        <xs:restriction base="xs:string">
            <xs:enumeration value="red"/>
            <xs:enumeration value="blue"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="person" type="tns:Person"/>
    <xs:element name="root" type="tns:RootType"/>
</xs:schema>
