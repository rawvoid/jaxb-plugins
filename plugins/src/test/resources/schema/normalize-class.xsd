<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://www.github.com/rawvoid/xjc-plugins/normalize"
           xmlns:tns="https://www.github.com/rawvoid/xjc-plugins/normalize"
           elementFormDefault="qualified">

    <xs:complexType name="NormalizeRoot">
        <xs:sequence>
            <xs:element name="group">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="entry">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="value" type="xs:string"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="anotherGroup">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="entry">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="value" type="xs:string"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="emptyChild" type="tns:EmptyChild"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="BaseType" abstract="true"/>

    <xs:complexType name="EmptyChild">
        <xs:complexContent>
            <xs:extension base="tns:BaseType"/>
        </xs:complexContent>
    </xs:complexType>

    <xs:element name="normalizeRoot" type="tns:NormalizeRoot"/>
</xs:schema>
