<!--
  Fixtures for RenameMultiElementPropPlugin:
  - Unbounded multi-element choice → long …Or… name without the plugin
  - Two multi choices on one type → items + items2 after rename
  - Plain single-element list must keep its natural name
  - Base + extension both declare Time (+ Note) → multi-member rest → items
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://www.github.com/rawvoid/xjc-plugins/rename-multi-element-prop"
           xmlns:tns="https://www.github.com/rawvoid/xjc-plugins/rename-multi-element-prop"
           elementFormDefault="qualified">

    <!-- One unbounded choice → long …Or… property name without the plugin. -->
    <xs:complexType name="Bag">
        <xs:choice maxOccurs="unbounded">
            <xs:element name="Alpha" type="xs:string"/>
            <xs:element name="Beta" type="xs:string"/>
            <xs:element name="Gamma" type="xs:string"/>
        </xs:choice>
    </xs:complexType>

    <!-- Two multi-element choices on one type → items + items2 after rename. -->
    <xs:complexType name="DualChoice">
        <xs:sequence>
            <xs:choice maxOccurs="unbounded">
                <xs:element name="One" type="xs:string"/>
                <xs:element name="Two" type="xs:string"/>
                <xs:element name="Three" type="xs:string"/>
            </xs:choice>
            <xs:choice maxOccurs="unbounded">
                <xs:element name="Red" type="xs:string"/>
                <xs:element name="Green" type="xs:string"/>
                <xs:element name="Blue" type="xs:string"/>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>

    <!-- Plain single-element list must keep its natural name. -->
    <xs:complexType name="PlainList">
        <xs:sequence>
            <xs:element name="Tag" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!--
      Base + extension both declare element Time (plus Note) → XJC multi-member
      catch-all "rest" property on Derived (getElements().size() > 1).
    -->
    <xs:complexType name="TimedBase">
        <xs:sequence>
            <xs:element name="Time" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="TimedDerived">
        <xs:complexContent>
            <xs:extension base="tns:TimedBase">
                <xs:sequence>
                    <xs:element name="Time" type="xs:string"/>
                    <xs:element name="Note" type="xs:string" minOccurs="0"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:element name="bag" type="tns:Bag"/>
    <xs:element name="dual" type="tns:DualChoice"/>
    <xs:element name="plain" type="tns:PlainList"/>
    <xs:element name="timed" type="tns:TimedDerived"/>
</xs:schema>
